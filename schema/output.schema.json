{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-decision-collapsible-gen-card/output.schema.json",
  "title": "AiDecisionCard output (v1.2.0)",
  "description": "Produced on submit. Chat cards post a readable line followed by this JSON in a ```json block; the browser page downloads ONE ZIP (answers.json, answers.md, files/*) named <id>[_<name>]_<YYYYMMDD_HHMMSS>.zip (editable before export); onSubmit receives {line, json}.",
  "type": "object",
  "required": [
    "artifact_id",
    "engine",
    "lang",
    "exported_at",
    "answers",
    "attachments",
    "summary_comments",
    "missing_blocking"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string",
      "description": "Input id."
    },
    "engine": {
      "type": "string",
      "description": "e.g. 'AiDecisionCard 1.0.0'."
    },
    "lang": {
      "type": "string",
      "description": "Language the card was shown in."
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "answers": {
      "type": "object",
      "description": "One entry per question id.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "question",
          "blocking",
          "multi",
          "answer",
          "answer_label",
          "own_answer",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "description": "Question title as displayed."
          },
          "blocking": {
            "type": "boolean"
          },
          "multi": {
            "type": "boolean"
          },
          "answer": {
            "description": "Option key (single), array of keys (multi), or null. '__other' = own answer.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "answer_label": {
            "description": "Displayed label(s) matching 'answer', in the display language.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "own_answer": {
            "type": "string",
            "description": "Text typed for 'My own answer'; empty when not chosen."
          },
          "notes": {
            "type": "string",
            "description": "Per-question comment; empty when not filled."
          },
          "answer_notes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Multi-choice only: comment per selected answer key, when filled."
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "description": "Files picked with Attach or pasted with Ctrl+V. File content is never inside the JSON.",
      "items": {
        "type": "object",
        "required": [
          "level",
          "name",
          "size",
          "type",
          "delivery"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "enum": [
              "card",
              "question",
              "answer"
            ]
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "Option key (level 'answer': multi-choice details box; dropped if that answer is deselected)."
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "delivery": {
            "enum": [
              "chat",
              "zip"
            ],
            "description": "chat: user pastes/drops the file into the chat after submitting; zip: inside the exported ZIP at saved_as."
          },
          "saved_as": {
            "type": "string",
            "description": "Path inside the ZIP, e.g. files/screenshot_20261027_120000.png (delivery 'zip')."
          }
        }
      }
    },
    "summary_comments": {
      "type": "string"
    },
    "missing_blocking": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Blocking question ids left unanswered (always empty when sent from the card, since sending is blocked)."
    },
    "card_ref": {
      "type": "string",
      "description": "Input ref, when given."
    },
    "respondent": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "description": "Multi-user cards (who) only."
    }
  }
}
